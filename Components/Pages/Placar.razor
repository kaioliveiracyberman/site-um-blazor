@page "/placar"
@rendermode InteractiveServer

<h1>Placar: @pontos</h1>

<button class="btn btn-success" @onclick="Somar">Somar 1 Ponto</button>
<button class="btn btn-warning" @onclick="Subtrair">Subtrair 1 Ponto</button>
<button class="btn btn-danger" @onclick="Zerar">Zerar Placar</button>

@code {
    private int pontos = 0;

    private void Somar()
    {
        pontos++;
    }

    private void Subtrair()
    {
        if (pontos > 0)
        {
            pontos--;
        }
    }

    private void Zerar()
    {
        pontos = 0;
    }
}